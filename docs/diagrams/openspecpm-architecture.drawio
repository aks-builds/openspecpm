        <mxCell id="fs_openspec" value="📁  openspec/   (committed)&#10;&#10;changes/&lt;feature&gt;/&#10;  ├── proposal.md          frontmatter: status, external&#10;  ├── design.md&#10;  ├── tasks.md             frontmatter: items[] w/ sync_state, external_id&#10;  ├── specs/*.md           Given/When/Then BDD scenarios&#10;  └── updates/&lt;task&gt;/progress.md&#10;archive/&lt;YYYY-MM-DD&gt;-&lt;feature&gt;/&#10;&#10;Written by:  OpenSpec Bridge, Tracking, sync command" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#444444;fontSize=11;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;strokeWidth=2" vertex="1" parent="lane_persist">
          <mxGeometry x="20" y="34" width="780" height="194" as="geometry" />
        </mxCell>
        <mxCell id="fs_cfg" value="📁  .openspecpm/   (mostly gitignored)&#10;&#10;config.json              adapter + repo/org/project   (committed)&#10;state.json               runtime cache                (.gitignore'd)&#10;config.local.json        local overrides              (.gitignore'd)&#10;audit.log                JSONL, secrets scrubbed      (.gitignore'd)&#10;&#10;Written by:  Config, Audit log" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#444444;fontSize=11;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;strokeWidth=2" vertex="1" parent="lane_persist">
