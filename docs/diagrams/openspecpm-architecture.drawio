        <mxCell id="lane_persist" value="Persistence &amp; sinks   (written/read by Core services — no arrows drawn to avoid crossings)" style="swimlane;fontStyle=1;horizontal=1;startSize=26;fillColor=#ECEFF1;strokeColor=#666666;rounded=1;swimlaneFillColor=#FFFFFF;fontSize=12" vertex="1" parent="1">
