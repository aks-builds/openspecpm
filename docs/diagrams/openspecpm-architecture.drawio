<mxfile host="app.diagrams.net" agent="openspecpm-scaffold" version="24.0.0">
  <diagram name="OpenSpecPM Architecture" id="arch">
    <mxGraphModel dx="2000" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- TITLE -->
        <mxCell id="title" value="OpenSpecPM — System Architecture" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=22;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1620" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Top-down flow. Each adapter sits directly above the external system it talks to. Swap brand boxes for real logos in the draw.io UI." style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=2;fontColor=#666666" vertex="1" parent="1">
          <mxGeometry x="40" y="56" width="1620" height="24" as="geometry" />
        </mxCell>

        <!-- ===== LAYER 1: USERS (3 boxes, centered) ===== -->
        <mxCell id="user_pm" value="Project Manager / BA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="380" y="110" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="user_dev" value="Developer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="740" y="110" width="220" height="60" as="geometry" />
