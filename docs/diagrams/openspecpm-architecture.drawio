        <!-- Core → Adapters -->
        <mxCell id="e7" style="endArrow=classic;html=1;strokeColor=#9673A6;strokeWidth=3" edge="1" parent="1" source="lane_core" target="lane_adapters"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Each adapter → its external (5 clean vertical lines) -->
        <mxCell id="e8" style="endArrow=classic;html=1;strokeColor=#222222;strokeWidth=3" edge="1" parent="1" source="ad_github" target="ext_github"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" style="endArrow=classic;html=1;strokeColor=#0078D7;strokeWidth=3" edge="1" parent="1" source="ad_azure" target="ext_azure"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" style="endArrow=classic;html=1;strokeColor=#0052CC;strokeWidth=3" edge="1" parent="1" source="ad_jira" target="ext_jira"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" style="endArrow=classic;html=1;strokeColor=#5E6AD2;strokeWidth=3" edge="1" parent="1" source="ad_linear" target="ext_linear"><mxGeometry relative="1" as="geometry"/></mxCell>
