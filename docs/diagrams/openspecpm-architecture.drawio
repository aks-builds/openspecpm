        <mxCell id="ext_azure" value="Azure DevOps Boards" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D7;fontSize=12;strokeWidth=3" vertex="1" parent="lane_ext">
          <mxGeometry x="360" y="34" width="290" height="60" as="geometry" />
