        <mxCell id="sink_notify" value="🔔  Notification sinks&#10;(written by Notify on standup --broadcast)&#10;&#10;Slack incoming webhook&#10;Teams MessageCard&#10;Generic JSON webhook" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A154B;fontSize=11;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;strokeWidth=2" vertex="1" parent="lane_persist">
          <mxGeometry x="1340" y="34" width="260" height="194" as="geometry" />
