        <!-- ===== LAYER 3: COMMANDS (single swimlane with 5 groups inline) ===== -->
        <mxCell id="lane_cmds" value="Commands  (cli/src/commands/*.js)" style="swimlane;fontStyle=1;horizontal=1;startSize=26;fillColor=#D5E8D4;strokeColor=#82B366;rounded=1;swimlaneFillColor=#FFFFFF;fontSize=12" vertex="1" parent="1">
