        <!-- LEGEND -->
        <mxCell id="legend" value="Legend:&#10;━━━ solid arrows = primary control / data flow&#10;┄┄┄ dashed arrows = filesystem I/O, optional side-channel (OpenSpec CLI, webhooks)&#10;Colors match the brand of each external system; each adapter sits directly above the system it talks to." style="text;html=1;strokeColor=#999999;fillColor=#FAFAFA;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10;spacingLeft=12;spacingTop=8" vertex="1" parent="1">
