        <!-- ===== LAYER 2: ENTRY (2 boxes, centered) ===== -->
        <mxCell id="entry_skill" value="Agent Skill&#10;skill/openspecpm/SKILL.md&#10;&#10;Routes natural-language intent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#D97757;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="500" y="220" width="320" height="90" as="geometry" />
        </mxCell>
        <mxCell id="entry_cli" value="Node CLI&#10;cli/bin/openspecpm.js&#10;&#10;Commander dispatch + audit wrapper" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C5E1A5;strokeColor=#558B2F;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="880" y="220" width="320" height="90" as="geometry" />
