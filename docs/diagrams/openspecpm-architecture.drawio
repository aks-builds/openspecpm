        <mxCell id="ext_linear" value="Linear" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5E6AD2;fontSize=12;strokeWidth=3" vertex="1" parent="lane_ext">
          <mxGeometry x="1000" y="34" width="290" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ext_gitlab" value="GitLab Issues" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FC6D26;fontSize=12;strokeWidth=3" vertex="1" parent="lane_ext">
          <mxGeometry x="1320" y="34" width="290" height="60" as="geometry" />
        </mxCell>

        <!-- ===== BOTTOM: FILESYSTEM + NOTIFY SINKS (side by side) ===== -->
        <mxCell id="fs_openspec" value="📁  openspec/  (project working tree)&#10;&#10;changes/&lt;feature&gt;/&#10;  ├── proposal.md          frontmatter: status, external&#10;  ├── design.md&#10;  ├── tasks.md             frontmatter: items[] w/ sync_state, external_id&#10;  ├── specs/*.md           Given/When/Then BDD scenarios&#10;  └── updates/&lt;task&gt;/progress.md&#10;archive/&lt;YYYY-MM-DD&gt;-&lt;feature&gt;/" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#444444;fontSize=11;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;strokeWidth=2" vertex="1" parent="1">
          <mxGeometry x="40" y="990" width="780" height="200" as="geometry" />
        </mxCell>
        <mxCell id="fs_cfg" value="📁  .openspecpm/  (gitignored except config.json)&#10;&#10;config.json              adapter + repo/org/project&#10;state.json               runtime cache         (.gitignore'd)&#10;config.local.json        local overrides       (.gitignore'd)&#10;audit.log                JSONL, secrets scrubbed  (.gitignore'd)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#444444;fontSize=11;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;strokeWidth=2" vertex="1" parent="1">
          <mxGeometry x="840" y="990" width="500" height="200" as="geometry" />
        </mxCell>
        <mxCell id="sink_notify" value="🔔  Notification sinks&#10;(via standup --broadcast)&#10;&#10;Slack incoming webhook&#10;Teams MessageCard&#10;Generic JSON webhook" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A154B;fontSize=11;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;strokeWidth=2" vertex="1" parent="1">
          <mxGeometry x="1360" y="990" width="300" height="200" as="geometry" />
        </mxCell>

        <!-- ===== OpenSpec CLI side note ===== -->
        <mxCell id="ext_openspec" value="@fission-ai/openspec   (shelled out)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2F1;strokeColor=#00897B;fontSize=11;strokeWidth=2;fontStyle=2" vertex="1" parent="1">
          <mxGeometry x="40" y="220" width="320" height="40" as="geometry" />
