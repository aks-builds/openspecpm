          <mxGeometry x="660" y="34" width="300" height="84" as="geometry" />
        </mxCell>
        <mxCell id="cmd_track" value="④ Track&#10;status • standup • next&#10;blocked • validate • search • watch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#82B366;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8" vertex="1" parent="lane_cmds">
          <mxGeometry x="980" y="34" width="300" height="84" as="geometry" />
        </mxCell>
        <mxCell id="cmd_exec" value="⑤ Execute / Ship&#10;fan-out • ship • help-table" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#82B366;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8" vertex="1" parent="lane_cmds">
          <mxGeometry x="1300" y="34" width="300" height="84" as="geometry" />
        </mxCell>

        <!-- ===== LAYER 4: CORE SERVICES (4 grouped boxes, fewer cells) ===== -->
        <mxCell id="lane_core" value="Core services  (cli/src/*)" style="swimlane;fontStyle=1;horizontal=1;startSize=26;fillColor=#FFE6CC;strokeColor=#D79B00;rounded=1;swimlaneFillColor=#FFFFFF;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="40" y="520" width="1620" height="140" as="geometry" />
        </mxCell>
        <mxCell id="core_spec" value="OpenSpec Bridge + BDD&#10;&#10;openspec-bridge.js&#10;bdd/linter.js + templates.js" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#D79B00;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8" vertex="1" parent="lane_core">
          <mxGeometry x="20" y="34" width="380" height="94" as="geometry" />
        </mxCell>
        <mxCell id="core_track" value="Tracking + Audit&#10;&#10;tracking.js (deps, status, recent)&#10;audit.js (JSONL, secrets scrubbed)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#D79B00;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8" vertex="1" parent="lane_core">
          <mxGeometry x="420" y="34" width="380" height="94" as="geometry" />
        </mxCell>
        <mxCell id="core_http" value="HTTP + Rate-limit&#10;&#10;http.js (Basic auth, JSON)&#10;ratelimit.js (token bucket per adapter)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#D79B00;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8" vertex="1" parent="lane_core">
          <mxGeometry x="820" y="34" width="380" height="94" as="geometry" />
        </mxCell>
        <mxCell id="core_io" value="Config + Notify + Telemetry&#10;&#10;config.js • frontmatter.js&#10;notify.js • telemetry.js" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#D79B00;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8" vertex="1" parent="lane_core">
          <mxGeometry x="1220" y="34" width="380" height="94" as="geometry" />
        </mxCell>

        <!-- ===== LAYER 5: ADAPTER CONTRACT (5 boxes evenly spaced to match externals below) ===== -->
        <mxCell id="lane_adapters" value="Adapter contract  (cli/src/adapters/*  —  9 methods + capabilities())" style="swimlane;fontStyle=1;horizontal=1;startSize=26;fillColor=#E1D5E7;strokeColor=#9673A6;rounded=1;swimlaneFillColor=#FFFFFF;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="40" y="700" width="1620" height="110" as="geometry" />
        </mxCell>
        <mxCell id="ad_github" value="GitHub&#10;github.js · depth 2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#222222;strokeColor=#000000;fontColor=#FFFFFF;fontSize=12;fontStyle=1" vertex="1" parent="lane_adapters">
          <mxGeometry x="40" y="34" width="290" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ad_azure" value="Azure DevOps&#10;azure.js · depth 4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0078D7;strokeColor=#005A9E;fontColor=#FFFFFF;fontSize=12;fontStyle=1" vertex="1" parent="lane_adapters">
          <mxGeometry x="360" y="34" width="290" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ad_jira" value="Jira&#10;jira.js · depth 3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0052CC;strokeColor=#003580;fontColor=#FFFFFF;fontSize=12;fontStyle=1" vertex="1" parent="lane_adapters">
          <mxGeometry x="680" y="34" width="290" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ad_linear" value="Linear&#10;linear.js · depth 2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#5E6AD2;strokeColor=#3F47A0;fontColor=#FFFFFF;fontSize=12;fontStyle=1" vertex="1" parent="lane_adapters">
          <mxGeometry x="1000" y="34" width="290" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ad_gitlab" value="GitLab&#10;gitlab.js · depth 2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FC6D26;strokeColor=#C44A19;fontColor=#FFFFFF;fontSize=12;fontStyle=1" vertex="1" parent="lane_adapters">
          <mxGeometry x="1320" y="34" width="290" height="60" as="geometry" />
        </mxCell>

        <!-- ===== LAYER 6: EXTERNAL SYSTEMS (aligned 1:1 below adapters) ===== -->
        <mxCell id="lane_ext" value="External PM systems" style="swimlane;fontStyle=1;horizontal=1;startSize=26;fillColor=#F5F5F5;strokeColor=#888888;rounded=1;swimlaneFillColor=#FFFFFF;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="40" y="850" width="1620" height="110" as="geometry" />
