        <mxCell id="e4" value="invokes" style="endArrow=classic;html=1;strokeColor=#D97757;strokeWidth=2;fontSize=10;fontStyle=2" edge="1" parent="1" source="entry_skill" target="entry_cli"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Entry → Commands (1 fat arrow to the lane) -->
        <mxCell id="e5" style="endArrow=classic;html=1;strokeColor=#82B366;strokeWidth=3" edge="1" parent="1" source="entry_cli" target="lane_cmds"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Commands → Core (one fat arrow between the two lanes) -->
