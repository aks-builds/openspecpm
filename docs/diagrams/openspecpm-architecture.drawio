        <mxCell id="user_agent" value="AI Agent (Claude Code)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#D97757;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1100" y="110" width="220" height="60" as="geometry" />
