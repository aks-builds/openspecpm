        <!-- ===================================================== -->
        <!-- ARROWS — STRICT VERTICAL, MINIMAL LABELS              -->
        <!-- ===================================================== -->

        <!-- Users → Entry (only the strong ones) -->
        <mxCell id="e1" style="endArrow=classic;html=1;strokeColor=#6C8EBF;strokeWidth=2" edge="1" parent="1" source="user_pm" target="entry_skill"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="endArrow=classic;html=1;strokeColor=#558B2F;strokeWidth=2" edge="1" parent="1" source="user_dev" target="entry_cli"><mxGeometry relative="1" as="geometry"/></mxCell>
