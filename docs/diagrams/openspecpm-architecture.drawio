        <!-- Core → OpenSpec CLI (side note, dashed) -->
        <mxCell id="e13" style="endArrow=classic;html=1;strokeColor=#00897B;strokeWidth=2;dashed=1" edge="1" parent="1" source="core_spec" target="ext_openspec"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Core → Filesystem (1 grouped arrow) -->
        <mxCell id="e14" value="reads / writes" style="endArrow=classic;html=1;strokeColor=#444444;strokeWidth=2;fontSize=10;fontStyle=2;dashed=1" edge="1" parent="1" source="core_track" target="fs_openspec"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e15" style="endArrow=classic;html=1;strokeColor=#444444;strokeWidth=2;dashed=1" edge="1" parent="1" source="core_io" target="fs_cfg"><mxGeometry relative="1" as="geometry"/></mxCell>

