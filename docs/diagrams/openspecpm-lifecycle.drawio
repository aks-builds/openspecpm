              <mxPoint x="1380" y="650" />
              <mxPoint x="160" y="650" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- ROW 4: track commands link sequentially (subtle, no labels) -->
        <mxCell id="a15" style="endArrow=classic;html=1;strokeColor=#A5D6A7;strokeWidth=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0" edge="1" parent="1" source="cmd_status_box" target="cmd_standup_box">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a16" style="endArrow=classic;html=1;strokeColor=#A5D6A7;strokeWidth=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0" edge="1" parent="1" source="cmd_standup_box" target="cmd_blocked_box">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a17" style="endArrow=classic;html=1;strokeColor=#A5D6A7;strokeWidth=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0" edge="1" parent="1" source="cmd_blocked_box" target="cmd_search_box">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a18" style="endArrow=classic;html=1;strokeColor=#A5D6A7;strokeWidth=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0" edge="1" parent="1" source="cmd_search_box" target="cmd_watch_box">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a19" style="endArrow=classic;html=1;strokeColor=#A5D6A7;strokeWidth=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0" edge="1" parent="1" source="cmd_watch_box" target="cmd_bug_box">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Row 4 → Row 5 ship (down-left from bug back to ship) -->
        <mxCell id="a20" style="endArrow=classic;html=1;strokeColor=#D32F2F;strokeWidth=2;exitX=0;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0" edge="1" parent="1" source="cmd_bug_box" target="cmd_ship_box">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1340" y="790" />
              <mxPoint x="250" y="790" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- ROW 5: ship → shipped → loop -->
        <mxCell id="a21" style="endArrow=classic;html=1;strokeColor=#2E7D32;strokeWidth=3;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0" edge="1" parent="1" source="cmd_ship_box" target="step_shipped">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a22" style="endArrow=classic;html=1;strokeColor=#F9A825;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0" edge="1" parent="1" source="step_shipped" target="step_loop">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
