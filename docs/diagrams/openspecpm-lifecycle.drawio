<mxfile host="app.diagrams.net" agent="openspecpm-scaffold" version="24.0.0">
  <diagram name="OpenSpecPM Lifecycle" id="lifecycle">
    <mxGraphModel dx="2000" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- TITLE -->
        <mxCell id="title" value="OpenSpecPM — End-to-End Lifecycle" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=22;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1620" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Idea → proposal → BDD specs → tasks → tracked work items → shipped code. Read left-to-right, top-to-bottom." style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=2;fontColor=#666666" vertex="1" parent="1">
          <mxGeometry x="40" y="56" width="1620" height="24" as="geometry" />
        </mxCell>

        <!-- ===== ROW 1: PLAN ===== -->
        <mxCell id="phase_plan_label" value="① PLAN" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontStyle=1;fontColor=#6C8EBF" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="100" height="24" as="geometry" />
        </mxCell>

        <mxCell id="step_idea" value="💡  Idea&#10;(stakeholder feature request,&#10;bug, or refactor need)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=12;align=center" vertex="1" parent="1">
          <mxGeometry x="40" y="140" width="220" height="100" as="geometry" />
        </mxCell>

        <mxCell id="cmd_propose_box" value="openspecpm propose &lt;feature&gt;&#10;&#10;Shells out to OpenSpec CLI.&#10;Soft BDD lint after authoring.&#10;--offline scaffolds from templates." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8" vertex="1" parent="1">
          <mxGeometry x="300" y="140" width="280" height="100" as="geometry" />
        </mxCell>

        <mxCell id="artifact_proposal" value="📄 openspec/changes/&lt;feature&gt;/&#10;  ├── proposal.md&#10;  ├── design.md&#10;  ├── tasks.md (empty items[])&#10;  └── specs/main.md (Given/When/Then)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#444444;fontSize=10;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8" vertex="1" parent="1">
          <mxGeometry x="620" y="140" width="320" height="100" as="geometry" />
        </mxCell>

        <mxCell id="cmd_decompose_box" value="openspecpm decompose &lt;feature&gt;&#10;&#10;Extracts tasks from proposal headings,&#10;checklists, and BDD scenarios in specs/." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8" vertex="1" parent="1">
          <mxGeometry x="980" y="140" width="280" height="100" as="geometry" />
        </mxCell>

        <mxCell id="artifact_tasks" value="📄 tasks.md (populated)&#10;items:&#10;  - title: &quot;Implement X&quot;&#10;    sync_state: pending&#10;    depends_on: []&#10;    parallel: true" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#444444;fontSize=10;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8" vertex="1" parent="1">
          <mxGeometry x="1300" y="140" width="320" height="100" as="geometry" />
        </mxCell>

        <!-- arrows row 1 -->
        <mxCell id="a_idea_propose" style="endArrow=classic;html=1;strokeColor=#82B366;strokeWidth=2" edge="1" parent="1" source="step_idea" target="cmd_propose_box"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a_propose_artifact" style="endArrow=classic;html=1;strokeColor=#444444" edge="1" parent="1" source="cmd_propose_box" target="artifact_proposal"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a_artifact_decompose" style="endArrow=classic;html=1;strokeColor=#82B366;strokeWidth=2" edge="1" parent="1" source="artifact_proposal" target="cmd_decompose_box"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a_decompose_tasks" style="endArrow=classic;html=1;strokeColor=#444444" edge="1" parent="1" source="cmd_decompose_box" target="artifact_tasks"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- ===== ROW 2: REVIEW + SYNC ===== -->
        <mxCell id="phase_sync_label" value="② REVIEW + SYNC" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontStyle=1;fontColor=#9673A6" vertex="1" parent="1">
          <mxGeometry x="40" y="280" width="200" height="24" as="geometry" />
        </mxCell>

        <mxCell id="step_review" value="👀 Human review&#10;(stakeholders sign off&#10;on BDD scenarios)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=12;align=center" vertex="1" parent="1">
          <mxGeometry x="40" y="320" width="220" height="100" as="geometry" />
        </mxCell>

        <mxCell id="cmd_validate_box" value="openspecpm validate&#10;&#10;Schema sweep:&#10;• proposal frontmatter&#10;• task sync_state enum&#10;• depends_on resolves&#10;• BDD lint summary" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8" vertex="1" parent="1">
          <mxGeometry x="300" y="320" width="280" height="100" as="geometry" />
        </mxCell>

        <mxCell id="cmd_sync_box" value="openspecpm sync &lt;feature&gt;&#10;&#10;Hard BDD lint (--force overrides).&#10;Idempotent: re-runs skip created,&#10;retry failed. Updates frontmatter&#10;with external_id + sync_state." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8" vertex="1" parent="1">
          <mxGeometry x="620" y="320" width="320" height="100" as="geometry" />
        </mxCell>

        <mxCell id="adapter_fanout" value="↓ via Adapter contract&#10;capabilities() drives hierarchy collapse" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;fontStyle=2;fontColor=#9673A6" vertex="1" parent="1">
          <mxGeometry x="620" y="430" width="320" height="20" as="geometry" />
        </mxCell>

        <mxCell id="backend_github_lc" value="GitHub&#10;Issues+sub-issues&#10;(depth 2)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#222222;strokeColor=#000000;fontColor=#FFFFFF;fontSize=10;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="980" y="320" width="120" height="50" as="geometry" />
        </mxCell>
        <mxCell id="backend_azure_lc" value="ADO Boards&#10;Epic→Feature→Story&#10;→Task (depth 4)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0078D7;strokeColor=#005A9E;fontColor=#FFFFFF;fontSize=10;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1110" y="320" width="120" height="50" as="geometry" />
        </mxCell>
        <mxCell id="backend_jira_lc" value="Jira&#10;Epic→Story→&#10;Sub-task (depth 3)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0052CC;strokeColor=#003580;fontColor=#FFFFFF;fontSize=10;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1240" y="320" width="120" height="50" as="geometry" />
        </mxCell>
        <mxCell id="backend_linear_lc" value="Linear&#10;Project→Issue&#10;(depth 2)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#5E6AD2;strokeColor=#3F47A0;fontColor=#FFFFFF;fontSize=10;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1370" y="320" width="120" height="50" as="geometry" />
        </mxCell>
        <mxCell id="backend_gitlab_lc" value="GitLab&#10;Issues+labels&#10;(depth 2)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FC6D26;strokeColor=#C44A19;fontColor=#FFFFFF;fontSize=10;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1500" y="320" width="120" height="50" as="geometry" />
        </mxCell>

        <mxCell id="backend_one_of" value="↑ exactly one selected at init time" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;fontStyle=2;fontColor=#666666" vertex="1" parent="1">
          <mxGeometry x="980" y="380" width="640" height="40" as="geometry" />
        </mxCell>

        <!-- arrows row 2 -->
        <mxCell id="a_review_validate" style="endArrow=classic;html=1;strokeColor=#82B366;strokeWidth=2" edge="1" parent="1" source="step_review" target="cmd_validate_box"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a_validate_sync" style="endArrow=classic;html=1;strokeColor=#82B366;strokeWidth=2" edge="1" parent="1" source="cmd_validate_box" target="cmd_sync_box"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a_sync_gh" style="endArrow=classic;html=1;strokeColor=#222222;dashed=1" edge="1" parent="1" source="cmd_sync_box" target="backend_github_lc"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a_tasks_review" style="endArrow=classic;html=1;strokeColor=#444444;dashed=1" edge="1" parent="1" source="artifact_tasks" target="step_review"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- ===== ROW 3: EXECUTE ===== -->
        <mxCell id="phase_exec_label" value="③ EXECUTE" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontStyle=1;fontColor=#D79B00" vertex="1" parent="1">
          <mxGeometry x="40" y="470" width="200" height="24" as="geometry" />
        </mxCell>

        <mxCell id="cmd_next_box" value="openspecpm next&#10;&#10;Lists open tasks with&#10;no unmet dependencies." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8" vertex="1" parent="1">
          <mxGeometry x="40" y="510" width="220" height="100" as="geometry" />
        </mxCell>

        <mxCell id="cmd_fanout_box" value="openspecpm fan-out &lt;feature&gt;&#10;&#10;Emits ready-to-paste agent prompts&#10;for parallel:true tasks. Each prompt&#10;embeds proposal + design + spec." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8" vertex="1" parent="1">
          <mxGeometry x="300" y="510" width="280" height="100" as="geometry" />
        </mxCell>

        <mxCell id="step_build" value="🤖 Agents implement&#10;(or human developer)&#10;&#10;BDD scenarios are the&#10;acceptance criteria." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#D97757;fontSize=11;align=center" vertex="1" parent="1">
          <mxGeometry x="620" y="510" width="280" height="100" as="geometry" />
        </mxCell>

        <mxCell id="cmd_comment_box" value="openspecpm comment&#10;&lt;feature&gt; &lt;task&gt; -m &quot;...&quot;&#10;&#10;Broadcasts progress.md (or -m) to the&#10;PM tool with auto SYNCED timestamp." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8" vertex="1" parent="1">
          <mxGeometry x="940" y="510" width="280" height="100" as="geometry" />
        </mxCell>

        <mxCell id="cmd_reconcile_box" value="openspecpm reconcile &lt;feature&gt;&#10;&#10;Pulls remote work-item state back&#10;into local frontmatter — detects&#10;out-of-band closes/moves." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8" vertex="1" parent="1">
          <mxGeometry x="1260" y="510" width="280" height="100" as="geometry" />
        </mxCell>

        <!-- arrows row 3 -->
        <mxCell id="a_sync_next" style="endArrow=classic;html=1;strokeColor=#D79B00;strokeWidth=2" edge="1" parent="1" source="cmd_sync_box" target="cmd_next_box"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a_next_fanout" style="endArrow=classic;html=1;strokeColor=#D79B00" edge="1" parent="1" source="cmd_next_box" target="cmd_fanout_box"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a_fanout_build" style="endArrow=classic;html=1;strokeColor=#D97757;strokeWidth=2" edge="1" parent="1" source="cmd_fanout_box" target="step_build"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a_build_comment" style="endArrow=classic;html=1;strokeColor=#D79B00" edge="1" parent="1" source="step_build" target="cmd_comment_box"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a_comment_reconcile" style="endArrow=classic;html=1;strokeColor=#D79B00" edge="1" parent="1" source="cmd_comment_box" target="cmd_reconcile_box"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- ===== ROW 4: TRACK ===== -->
        <mxCell id="phase_track_label" value="④ TRACK" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontStyle=1;fontColor=#82B366" vertex="1" parent="1">
          <mxGeometry x="40" y="650" width="200" height="24" as="geometry" />
        </mxCell>

        <mxCell id="cmd_status_box" value="status&#10;Per-change task counts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#82B366;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="40" y="690" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="cmd_standup_box" value="standup [--broadcast]&#10;Recent progress, → Slack/Teams" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#82B366;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="300" y="690" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="cmd_blocked_box" value="blocked&#10;Tasks waiting on deps" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#82B366;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="560" y="690" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="cmd_search_box" value="search &lt;query&gt;&#10;Grep across proposals/specs/notes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#82B366;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="820" y="690" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="cmd_watch_box" value="watch [feature]&#10;Debounced re-lint on file change" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#82B366;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="1080" y="690" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="cmd_bug_box" value="bug-report &lt;feat&gt; &lt;task&gt;&#10;File a linked regression" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#82B366;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="1340" y="690" width="220" height="60" as="geometry" />
        </mxCell>

        <!-- ===== ROW 5: SHIP ===== -->
        <mxCell id="phase_ship_label" value="⑤ SHIP" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontStyle=1;fontColor=#D32F2F" vertex="1" parent="1">
          <mxGeometry x="40" y="790" width="200" height="24" as="geometry" />
        </mxCell>

        <mxCell id="cmd_ship_box" value="openspecpm ship &lt;feature&gt;&#10;or --all-ready&#10;&#10;1. Close every synced task via adapter&#10;2. Close the epic&#10;3. openspec archive → openspec/archive/&lt;date&gt;-&lt;feature&gt;/" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFCDD2;strokeColor=#D32F2F;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="830" width="380" height="110" as="geometry" />
        </mxCell>

        <mxCell id="step_shipped" value="🚀 Shipped&#10;&#10;Code merged, work items closed,&#10;OpenSpec change archived,&#10;audit log persisted." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=12;align=center;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="460" y="830" width="280" height="110" as="geometry" />
        </mxCell>

        <mxCell id="step_loop" value="↻ Next feature&#10;&#10;Re-enter from step ①&#10;with the next idea." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=12;align=center" vertex="1" parent="1">
          <mxGeometry x="780" y="830" width="220" height="110" as="geometry" />
        </mxCell>

        <mxCell id="cross_cut" value="Cross-cutting, runs on every command:&#10;• Audit log (.openspecpm/audit.log, secrets scrubbed)&#10;• Token-bucket rate limiting per adapter&#10;• OpenSpec version probe (anti-corruption layer)&#10;• Optional telemetry (opt-in, audit-only in alpha)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontStyle=2" vertex="1" parent="1">
          <mxGeometry x="1040" y="830" width="580" height="110" as="geometry" />
        </mxCell>

        <!-- arrows row 5 -->
        <mxCell id="a_track_ship" style="endArrow=classic;html=1;strokeColor=#D32F2F;strokeWidth=2" edge="1" parent="1" source="cmd_status_box" target="cmd_ship_box"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a_ship_shipped" style="endArrow=classic;html=1;strokeColor=#2E7D32;strokeWidth=3" edge="1" parent="1" source="cmd_ship_box" target="step_shipped"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a_shipped_loop" style="endArrow=classic;html=1;strokeColor=#F9A825;strokeWidth=2" edge="1" parent="1" source="step_shipped" target="step_loop"><mxGeometry relative="1" as="geometry"/></mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
