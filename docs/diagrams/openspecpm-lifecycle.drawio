        <mxCell id="a12" style="endArrow=classic;html=1;strokeColor=#D79B00;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0" edge="1" parent="1" source="step_build" target="cmd_comment_box">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a13" style="endArrow=classic;html=1;strokeColor=#D79B00;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0" edge="1" parent="1" source="cmd_comment_box" target="cmd_reconcile_box">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Row 3 reconcile → Row 4 status (down-left routed) -->
        <mxCell id="a14" style="endArrow=classic;html=1;strokeColor=#82B366;strokeWidth=2;exitX=0;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0" edge="1" parent="1" source="cmd_reconcile_box" target="cmd_status_box">
          <mxGeometry relative="1" as="geometry">
